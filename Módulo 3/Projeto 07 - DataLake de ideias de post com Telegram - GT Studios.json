      "parameters": {
        "jsCode": "const texto = $input.first().json.output;\n\nconst variacoes = texto\n  .split('---')\n  .map(v => v.trim())\n  .filter(v => v.length > 0);\n\nreturn variacoes.map((variacao, index) => ({\n  json: {\n    variacao: variacao,\n    numero: index + 1\n  }\n}));"
