    {
      "parameters": {
        "promptType": "define",
        "text": "=Você é um especialista em cinema e está criando descrições para um chatbot de filmes.\n\nCom base nos dados abaixo, escreva um resumo em português de 4 a 6 linhas sobre o filme.\nO resumo deve ser informativo, envolvente e adequado para responder perguntas de usuários\nque querem saber se vale a pena assistir.\n\nTítulo: {{ $json.titulo }}\nAno: {{ $json.ano }}\nGêneros: {{ $json.generos }}\nDiretor: {{ $json.diretor }}\nElenco principal: {{ $json.elenco }}\nSinopse: {{ $json.sinopse }}\nAvaliação IMDB: {{ $json.avaliacao }}/10\n\nRetorne SOMENTE o resumo, sem títulos, sem introdução, sem markdown.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1008,
        336
